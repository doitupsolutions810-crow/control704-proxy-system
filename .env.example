# Copy to .env (never commit .env). Values are placeholders.
AVRONE_ISSUER=https://avrone-due-krey.example.com
AVRONE_AUDIENCE=control704-proxy
# Option A: HS256 shared secret (>= 32 bytes)
AVRONE_JWT_SECRET=
# Option B: RS256/ES256 PEM public key (use \n for newlines if single-line)
AVRONE_JWT_PUBLIC_KEY=
AVRONE_CLOCK_SKEW_SEC=30
AVRONE_MAX_TOKEN_AGE_SEC=
HOST=127.0.0.1
PORT=8704
